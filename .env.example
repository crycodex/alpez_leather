# ─── Sitio ─────────────────────────────────────────────
PUBLIC_SITE_URL=https://alpezleather.com

# ─── Firebase (cliente: panel admin) ────────────────────
# Firebase Console → Configuración del proyecto → Tus apps → Web
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
# true para usar Firebase Emulator Suite en local
PUBLIC_USE_FIREBASE_EMULATORS=false

# ─── Firebase Admin (servidor: lectura SSR, pedidos, estadísticas) ──
# Firebase Console → Configuración → Cuentas de servicio → Generar clave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pega la clave con los \n literales, entre comillas
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Con emuladores (no requiere credenciales):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ─── Vercel ISR ─────────────────────────────────────────
# Cadena aleatoria de 32+ caracteres. Activa ISR y la revalidación desde el admin.
VERCEL_REVALIDATE_TOKEN=
