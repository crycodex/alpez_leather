---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/site/Icon.astro';
import { path, t } from '@/i18n';
import type { Locale } from '@/lib/schemas';
const locale: Locale = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
Astro.response.status = 404;
---
<Base locale={locale} route="home" title={t(locale, '404.title')} noindex>
  <section class="nf wrap">
    <p class="nf__code deboss" aria-hidden="true">404</p>
    <h1 class="nf__title">{t(locale, '404.title')}</h1>
    <p class="lead">{t(locale, '404.body')}</p>
    <a class="btn" href={path(locale, 'shop')}>{t(locale, 'cta.shop')} <Icon name="arrow" /></a>
  </section>
</Base>
<style>
  .nf {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
    padding-block: var(--s-8) var(--s-10);
  }
  .nf__code {
    font-size: clamp(6rem, 3rem + 14vw, 16rem);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.85;
    letter-spacing: -0.04em;
  }
  .nf__title {
    font-size: var(--text-2xl);
  }
</style>
