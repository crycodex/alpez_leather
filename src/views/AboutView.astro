---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/site/Icon.astro';
import ProductImage from '@/components/site/ProductImage.astro';
import PendingNote from '@/components/site/PendingNote.astro';
import { getAbout, getSettings } from '@/lib/server/repo';
import { loc, path, t } from '@/i18n';
import { waLink } from '@/lib/whatsapp';
import type { Locale } from '@/lib/schemas';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const [about, settings] = await Promise.all([getAbout(), getSettings()]);
const L = (v: { es: string; en: string }) => loc(v, locale);
const paras = (s: string) => s.split(/\n{2,}|\n/).map((p) => p.trim()).filter(Boolean);
---
<Base locale={locale} route="about" title={L(about.title)} description={L(about.lead)}>
  <section class="ab-hero wrap">
    <h1 class="ab-hero__title deboss" data-press>{L(about.title)}</h1>
    <p class="ab-hero__lead">{L(about.lead)}</p>
  </section>

  <section class="wrap ab-media">
    <ProductImage image={about.image} alt={L(about.title)} locale={locale} ratio="16 / 9" sizes="100vw" eager reveal />
  </section>

  <section class="section">
    <div class="wrap ab-story">
      <h2 class="section-title deboss" data-press>{L(about.story.title)} <PendingNote locale={locale} show={about.story.pending} /></h2>
      <div class="prose">{paras(L(about.story.body)).map((p) => <p>{p}</p>)}</div>
    </div>
  </section>

  {
    about.values.length > 0 && (
      <section class="section section--light">
        <div class="wrap">
          <ul role="list" class="ab-values" data-rise>
            {about.values.map((v) => (
              <li>
                <h3 class="ab-values__title deboss">{L(v.title)}</h3>
                <p>{L(v.body)}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap ab-origin">
      <div>
        <h2 class="section-title deboss" data-press>{L(about.origin.title)} <PendingNote locale={locale} show={about.origin.pending} /></h2>
        <div class="prose">{paras(L(about.origin.body)).map((p) => <p>{p}</p>)}</div>
        <div class="ab-actions">
          <a class="btn" href={path(locale, 'shop')}>{t(locale, 'cta.shop')} <Icon name="arrow" /></a>
          <a class="btn btn--ghost" href={waLink(settings.whatsapp)} target="_blank" rel="noopener"><Icon name="whatsapp" /> {t(locale, 'cta.whatsapp')}</a>
        </div>
      </div>
      <div class="ab-gallery">
        {
          about.gallery.length
            ? about.gallery.slice(0, 4).map((img) => <ProductImage image={img} alt={L(about.origin.title)} locale={locale} ratio="1 / 1" sizes="(max-width: 900px) 50vw, 25vw" reveal />)
            : [0, 1, 2, 3].map(() => <ProductImage image={null} alt="" locale={locale} ratio="1 / 1" />)
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .ab-hero {
    padding-block: var(--s-7) var(--s-7);
    display: grid;
    gap: var(--s-5);
  }
  .ab-hero__title {
    font-size: clamp(3.2rem, 1.5rem + 8vw, 9rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 0.9;
  }
  .ab-hero__lead {
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.3;
    max-width: 30ch;
  }
  .ab-story,
  .ab-origin {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(2rem, 6vw, 7rem);
    align-items: start;
  }
  .ab-values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-7);
  }
  .ab-values li {
    display: grid;
    gap: var(--s-3);
    padding-top: var(--s-5);
    border-top: 1px dashed rgb(90 54 36 / 0.5);
  }
  .ab-values__title {
    font-size: var(--text-xl);
    font-weight: 400;
  }
  .ab-origin > div:first-child {
    display: grid;
    gap: var(--s-5);
  }
  .ab-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }
  .ab-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-4);
  }
  @media (max-width: 900px) {
    .ab-story,
    .ab-origin,
    .ab-values {
      grid-template-columns: 1fr;
    }
  }
</style>
