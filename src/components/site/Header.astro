---
import Icon from './Icon.astro';
import { loc, path, t } from '@/i18n';
import type { Category, Locale, SiteSettings } from '@/lib/schemas';
import { waLink } from '@/lib/whatsapp';

interface Props {
  locale: Locale;
  altHref: string;
  categories: Category[];
  settings: SiteSettings;
}
const { locale, altHref, categories, settings } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  return h === current || (h !== '/' && h !== '/en' && current.startsWith(h));
};
const links = [
  { href: path(locale, 'shop'), label: t(locale, 'nav.shop') },
  { href: path(locale, 'about'), label: t(locale, 'nav.about') },
];
---
<header class="hdr" data-header>
  <div class="hdr__bar wrap">
    <a class="hdr__logo" href={path(locale, 'home')} aria-label={`${settings.brandName} — ${locale === 'es' ? 'Inicio' : 'Home'}`}>
      <img src="/brand/mark-choc.png" width="297" height="128" alt="" class="hdr__mark" />
      <img src="/brand/word-choc.png" width="470" height="125" alt="" class="hdr__word" />
    </a>

    <nav class="hdr__nav" aria-label={locale === 'es' ? 'Principal' : 'Main'}>
      <ul role="list">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr__actions">
      <a class="hdr__lang label" href={altHref} hreflang={locale === 'es' ? 'en' : 'es'} lang={locale === 'es' ? 'en' : 'es'} aria-label={t(locale, 'lang.switch')}>
        {t(locale, 'lang.short')}
      </a>
      <button class="hdr__cart" type="button" data-cart-open aria-haspopup="dialog" aria-controls="cart-drawer">
        <Icon name="bag" size={22} />
        <span class="sr-only">{t(locale, 'nav.cart')}</span>
        <span class="hdr__count num" data-cart-count aria-live="polite">0</span>
      </button>
      <button class="hdr__menu" type="button" data-menu-open aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" size={24} />
        <span class="sr-only">{t(locale, 'nav.menu')}</span>
      </button>
    </div>
  </div>
  <hr class="stitch hdr__stitch" aria-hidden="true" />

  <div class="menu on-dark" id="mobile-menu" data-menu hidden>
    <div class="menu__top wrap">
      <img src="/brand/mark-sand.png" width="297" height="128" alt="" class="hdr__mark" />
      <button type="button" class="menu__close" data-menu-close>
        <Icon name="close" size={26} />
        <span class="sr-only">{t(locale, 'nav.close')}</span>
      </button>
    </div>
    <nav class="menu__nav wrap" aria-label={locale === 'es' ? 'Menú móvil' : 'Mobile menu'}>
      <ul role="list" class="menu__main">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <hr class="stitch" aria-hidden="true" />
      <ul role="list" class="menu__cats">
        {categories.map((c) => <li><a href={path(locale, 'category', c.slug)}>{loc(c.name, locale)}</a></li>)}
      </ul>
      <div class="menu__foot">
        <a class="btn btn--sand btn--block" href={waLink(settings.whatsapp)} target="_blank" rel="noopener">
          <Icon name="whatsapp" /> {t(locale, 'cta.whatsapp')}
        </a>
        <a class="label" href={altHref} lang={locale === 'es' ? 'en' : 'es'}>{t(locale, 'lang.switch')}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background-color var(--dur) var(--ease-out);
  }
  .hdr.is-scrolled {
    background: rgb(217 191 160 / 0.96);
  }
  .hdr__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-h);
  }
  .hdr__stitch {
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }
  .hdr.is-scrolled .hdr__stitch {
    opacity: 0.4;
  }
  .hdr__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    justify-self: start;
    text-decoration: none;
  }
  .hdr__mark {
    width: 2.6rem;
    height: auto;
  }
  .hdr__word {
    width: 6.2rem;
    height: auto;
  }
  .hdr__nav ul {
    display: flex;
    gap: var(--s-6);
  }
  .hdr__nav a {
    position: relative;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-stretch: var(--wide);
    text-decoration: none;
    padding-block: var(--s-2);
  }
  .hdr__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-image: linear-gradient(90deg, currentColor 0 6px, transparent 6px 10px);
    background-size: 10px 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out);
  }
  .hdr__nav a:hover::after,
  .hdr__nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .hdr__actions {
    display: flex;
    align-items: center;
    justify-content: end;
    gap: var(--s-4);
  }
  .hdr__lang {
    text-decoration: none;
    padding: var(--s-2);
  }
  .hdr__lang:hover {
    text-decoration: underline;
  }
  .hdr__cart {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    transition: background-color var(--dur) var(--ease-out);
  }
  .hdr__cart:hover {
    background: rgb(90 54 36 / 0.1);
  }
  .hdr__count {
    position: absolute;
    top: 0.1rem;
    right: 0;
    min-width: 1.25rem;
    height: 1.25rem;
    padding-inline: 0.3rem;
    border-radius: 999px;
    background: var(--choc);
    color: var(--sand-light);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.25rem;
    text-align: center;
    transform: scale(0);
    transition: transform 0.35s var(--ease-out);
  }
  .hdr__count.has-items {
    transform: scale(1);
  }
  .hdr__count.bump {
    animation: bump 0.5s var(--ease-out);
  }
  @keyframes bump {
    40% {
      transform: scale(1.35);
    }
  }
  .hdr__menu {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: var(--choc-deep);
    color: var(--sand-light);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .menu[hidden] {
    display: none;
  }
  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }
  .menu__close {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
  }
  .menu__nav {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    padding-block: var(--s-6) var(--s-7);
    flex: 1;
  }
  .menu__main a {
    font-size: var(--text-2xl);
    font-weight: 700;
    font-stretch: var(--wide);
    text-decoration: none;
    line-height: 1.2;
  }
  .menu__cats {
    display: grid;
    gap: var(--s-3);
  }
  .menu__cats a {
    font-size: var(--text-lg);
    text-decoration: none;
  }
  .menu__foot {
    margin-top: auto;
    display: grid;
    gap: var(--s-5);
    justify-items: center;
  }

  @media (max-width: 760px) {
    .hdr__bar {
      grid-template-columns: 1fr auto;
    }
    .hdr__nav,
    .hdr__lang {
      display: none;
    }
    .hdr__menu {
      display: inline-grid;
    }
    .hdr__word {
      width: 5.2rem;
    }
    .hdr__mark {
      width: 2.2rem;
    }
  }
</style>

<script>
  function initHeader() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header) return;
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const menu = header.querySelector<HTMLElement>('[data-menu]');
    const openBtn = header.querySelector<HTMLButtonElement>('[data-menu-open]');
    const closeBtn = header.querySelector<HTMLButtonElement>('[data-menu-close]');
    if (!menu || !openBtn || !closeBtn) return;
    const close = () => {
      menu.hidden = true;
      openBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      openBtn.focus();
    };
    openBtn.addEventListener('click', () => {
      menu.hidden = false;
      openBtn.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      closeBtn.focus();
    });
    closeBtn.addEventListener('click', close);
    menu.addEventListener('keydown', (e) => e.key === 'Escape' && close());
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
      menu.hidden = true;
      document.documentElement.style.overflow = '';
    }));
  }
  document.addEventListener('astro:page-load', initHeader);
</script>
