---
/** Iconos dibujados a mano, trazo 1.6, misma familia. */
interface Props {
  name: 'bag' | 'whatsapp' | 'instagram' | 'close' | 'plus' | 'minus' | 'arrow' | 'menu' | 'mountain' | 'check' | 'facebook' | 'tiktok' | 'mail' | 'pin';
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 20, class: cls, label } = Astro.props;
const paths: Record<Props['name'], string> = {
  bag: '<path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
  whatsapp:
    '<path d="M4 20l1.2-3.6A8 8 0 1 1 8 19.1L4 20Z"/><path d="M9 8.6c0 3.3 3 6.4 6.4 6.4l1.1-1.4-2-1-1 .8c-1-.4-2-1.4-2.4-2.4l.8-1-1-2L9.6 8"/>',
  instagram: '<rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.6"/><circle cx="16.8" cy="7.2" r=".6" fill="currentColor"/>',
  facebook: '<path d="M14 8h2V4.5h-2.5A3.5 3.5 0 0 0 10 8v2.5H8V14h2v6h3.5v-6H16l.5-3.5h-3V8.6c0-.4.2-.6.5-.6Z"/>',
  tiktok: '<path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 4c.4 2.4 2 4 4.5 4.3"/>',
  mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4 7 8 6 8-6"/>',
  pin: '<path d="M12 21s6.5-5.6 6.5-11a6.5 6.5 0 0 0-13 0c0 5.4 6.5 11 6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  minus: '<path d="M5 12h14"/>',
  arrow: '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
  menu: '<path d="M4 8h16M4 16h16"/>',
  check: '<path d="m5 12.5 4.2 4.2L19 7"/>',
  mountain: '<path d="M2 19 9.5 9.5l2.6 2.4"/><path d="M8.8 14.2 14.5 5 22 19"/>',
};
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={paths[name]}
/>
