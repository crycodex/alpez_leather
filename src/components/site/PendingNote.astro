---
/** Marca discreta de "contenido pendiente" junto a un bloque aún no redactado. */
import { t } from '@/i18n';
import type { Locale } from '@/lib/schemas';
interface Props {
  locale: Locale;
  show?: boolean;
}
const { locale, show = true } = Astro.props;
---
{show && <span class="pnote plate plate--pending label">{t(locale, 'pending.badge')}</span>}
<style>
  .pnote {
    font-size: 0.7rem;
    color: var(--choc-deep);
    vertical-align: middle;
  }
</style>
