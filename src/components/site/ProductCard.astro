---
import ProductImage from './ProductImage.astro';
import Price from './Price.astro';
import { loc, path, t } from '@/i18n';
import type { Locale, Product } from '@/lib/schemas';
interface Props {
  product: Product;
  locale: Locale;
  categoryName?: string;
  sizes?: string;
}
const { product, locale, categoryName, sizes } = Astro.props;
const name = loc(product.name, locale);
const second = product.images[1];
---
<article class="pc" data-price={product.price} data-order={product.order}>
  <a class="pc__link" href={path(locale, 'product', product.slug)}>
    <div class="pc__media">
      <ProductImage image={product.images[0]} alt={name} locale={locale} sizes={sizes} reveal />
      {second?.url && <img class="pc__alt" src={second.url} alt="" loading="lazy" />}
      {product.stockStatus !== 'available' && (
        <span class="pc__stock label">{t(locale, `product.stock.${product.stockStatus}`)}</span>
      )}
    </div>
    <div class="pc__info">
      <h3 class="pc__name">{name}</h3>
      {categoryName && <span class="pc__cat">{categoryName}</span>}
      <Price product={product} locale={locale} />
    </div>
  </a>
</article>

<style>
  .pc__link {
    display: grid;
    gap: var(--s-4);
    text-decoration: none;
  }
  .pc__media {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.6s var(--ease-out);
  }
  .pc__media :global(.pimg img),
  .pc__alt {
    transition:
      transform 1.2s var(--ease-out),
      opacity 0.6s var(--ease-out);
  }
  .pc__alt {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }
  .pc__link:hover .pc__alt {
    opacity: 1;
  }
  .pc__link:hover .pc__media :global(.pimg img) {
    transform: scale(1.04);
  }
  .pc__link:hover .pc__media {
    transform: translateY(-3px);
  }
  .pc__stock {
    position: absolute;
    top: var(--s-3);
    left: var(--s-3);
    background: var(--choc-deep);
    color: var(--sand-light);
    padding: 0.3rem 0.55rem;
    border-radius: 4px;
    font-size: 0.7rem;
  }
  .pc__info {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
  }
  .pc__cat {
    color: var(--choc);
    font-size: var(--text-sm);
    margin-top: calc(var(--s-1) * -1);
  }
  .pc__name {
    font-size: var(--text-md);
    font-weight: 400;
    font-stretch: 100%;
    letter-spacing: 0;
    line-height: 1.3;
  }
  .pc__link:hover .pc__name {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
